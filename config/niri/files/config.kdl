// Include monitor configuration generated by nwg-displays
include "monitor.kdl"
include "rules/workspaces.kdl"
include "rules/layers.kdl"
include "rules/windows.kdl"
include "startup.kdl"
include "binds.kdl"

// https://github.com/YaLTeR/niri/wiki/Configuration:-Overview

environment {
    GDK_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    QT_QPA_PLATFORM "wayland"
    XDG_SESSION_TYPE "wayland"

    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt6ct"

    MOZ_ENABLE_WAYLAND "1"
    MOZ_WEBRENDER "1"

    DISPLAY ":0"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-after-inactive-ms 1000;
}

hotkey-overlay { skip-at-startup; }

// https://github.com/YaLTeR/niri/wiki/Configuration:-Input
input {
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="25%"

    warp-mouse-to-focus

    // workspace-auto-back-and-forth

    keyboard {
        xkb {
            // xkeyboard-config(7)
            layout "us,ua"
            // options "grp:win_space_toggle, grp_led:caps, grp:shifts_toggle, ctrl:nocaps"
            options "grp:win_space_toggle, grp:shifts_toggle"
        }
        repeat-rate 30
        repeat-delay 200
    }

    trackpoint {
        // off
        accel-speed 0.2
        accel-profile "flat"
    }

    touchpad {
                                                         // off // touchpad
        tap
        dwt // disable while typing
        dwtp // disable while trackpointing
        natural-scroll
        accel-profile "flat"
        scroll-method "two-finger"
        scroll-factor 0.4
        tap-button-map "left-right-middle"
    }

    mouse {
        // off
        accel-profile "flat"
        accel-speed 0.4
    }
}

gestures {
    hot-corners { off; }
}

overview {
    // zoom 0.6
}

// niri msg outputs

// Integrated Thinkpad
output "Chimei Innolux Corporation 0x14C9 Unknown" {
    // off
    mode "1920x1080@60"
    scale 1
    transform "normal"
    position x=0 y=0
    // position x=1920 y=0
}

// Integrated Legion
// TODO: set it by name
output "eDP-2" {
    // off
    mode "1920x1080@144"
    scale 1
    transform "normal"
    // position x=1920 y=0
}

// Home LG
output "LG Electronics W2353 0x00005ADA" {
    mode "1920x1080@60"
    scale 1
    transform "normal"
    position x=0 y=0
}

// Handmade
output "IPS, Inc. (Intellectual Property Solutions, Inc.) HDMI 0x00000001" {
    mode "1366x768@59.790"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-3" {
    // off
    mode "1920x1080@60"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-5" {
    // off
    mode "1366x768@59.79"
    scale 1
    transform "normal"
    position x=554 y=1080
}

output "HDMI-A-2" {
    // off
    mode "1920x1080@60"
    scale 1
    transform "normal"
    // position x=1920 y=0

    layout {
        // Shrink the area occupied by windows, similarly to layer-shell panels.
       struts {
            left   35
            right  35
            top    0
            bottom 20
        }
    }
}

// https://github.com/YaLTeR/niri/wiki/Configuration:-Layout
layout {
    gaps 0
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // You can also customize the heights that "switch-preset-window-height" (Mod+Shift+R) toggles between.
    // preset-window-heights { }

    // If you leave the brackets empty, the windows themselves will decide their initial width.
    default-column-width { proportion 0.5; }

    focus-ring { off; }

    border {
        width 2
    }

    tab-indicator {
        width 5
        gap 2
        gaps-between-tabs 2
        length total-proportion=1.0
        position "left"
        place-within-column
        corner-radius 4
    }

    shadow {
        on
    }
}

// no client side decorations
prefer-no-csd

// null to disable
screenshot-path "~/pictures/screenshots/%Y-%m-%d|%H-%M-%S.png"

// https://github.com/YaLTeR/niri/wiki/Configuration:-Animations
animations {
    // off
}

switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock-and-suspend"; }
}

include "noctalia.kdl"
