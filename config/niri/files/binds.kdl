binds {
    Mod+Shift+Slash  { show-hotkey-overlay; }
    Ctrl+Alt+Delete allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Escape hotkey-overlay-title="Spawn Power Menu" { spawn "vicinae" "vicinae://launch/power"; }
    Mod+Shift+Escape { quit; }

    Mod+Return hotkey-overlay-title="Spawn Terminal"    { spawn "kitty"; }
    Alt+Space  hotkey-overlay-title="Spawn App runner"  { spawn-sh "vicinae toggle"; }

    Mod+U allow-when-locked=true hotkey-overlay-title="Toggle Lockscreen" { spawn-sh "killall -SIGUSR1 hyprlock || hyprlock"; }

    Mod+S { focus-workspace "social"; }
    Mod+B { focus-workspace "browser"; }

    Mod+W hotkey-overlay-title="Toggle overview" { toggle-overview; }

    Mod+Shift+W      hotkey-overlay-title="Open/Close Waybar"        { spawn-sh "killall waybar || waybar --config ~/.config/waybar/config"; }
    Mod+Shift+Ctrl+W hotkey-overlay-title="Toggle Waybar visibility" { spawn "killall" "-SIGUSR1" "waybar"; }


    XF86Keyboard { spawn-sh r#"sed -i -E 's/^( *)\/\/( off \/\/ touchpad)/\1\2/; t; s/^( *)(off \/\/ touchpad)/\1\/\/\ \2/' ~/.config/niri/config.kdl"#; }
    // Toggle struts
    F12 { spawn-sh r#"sed -i -E 's/^( *)\/-(struts \{)/\1\2/; t; s/^( *)(struts \{)/\1\/-\2/' ~/.config/niri/config.kdl"#; }

    XF86MonBrightnessUP    allow-when-locked=true { spawn "brightnessctl" "s" "5%+"; }
    XF86MonBrightnessDown  allow-when-locked=true { spawn "brightnessctl" "s" "5%-"; }

    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    Pause          allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    Shift+Alt+P    allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    Shift+Alt+N    allow-when-locked=true { spawn "playerctl" "next"; }

    XF86Calculator { spawn-sh "walker -m calc"; }
    XF86Favorites  { spawn-sh "walker -m calc"; }

    Print       { screenshot; }
    Mod+Print   { screenshot-screen; }
    Shift+Print { screenshot-window; }
    Mod+Shift+E { spawn "bash" "-c" r#"wl-paste | gradia"#; }

    Mod+Z       hotkey-overlay-title="Spawn Screen Recorder" { spawn  "gsr-ui" "launch-show"; }
    ALT+F9      { spawn "gsr-ui-cli" "toggle-record"; }

    Mod+V hotkey-overlay-title="Spawn Clipboard manager" { spawn "vicinae" "vicinae://launch/clipboard/history"; }
    Mod+E hotkey-overlay-title="Spawn Emoji picker"      { spawn "vicinae" "vicinae://launch/core/search-emojis"; }
    // Mod+Z { spawn "woomer"; }

    Mod+Q { close-window; }
    Mod+G { toggle-column-tabbed-display; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }

    // Mod+Shift+H    { move-column-left; }
    Mod+Shift+H { consume-or-expel-window-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { consume-or-expel-window-right; }
    // Mod+Shift+L    { move-column-right; }

    Mod+Home         { focus-column-first; }
    Mod+End          { focus-column-last; }
    Mod+Shift+Home   { move-column-to-first; }
    Mod+Shift+End    { move-column-to-last; }

    Mod+Ctrl+H       { focus-monitor-left; }
    Mod+Ctrl+J       { focus-monitor-down; }
    Mod+Ctrl+K       { focus-monitor-up; }
    Mod+Ctrl+L       { focus-monitor-right; }

    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }

    Mod+Shift+D      { move-workspace-down; }
    Mod+Shift+U      { move-workspace-up; }

    Mod+N { move-workspace-to-monitor-next; }
    Mod+Shift+N { move-workspace-to-monitor-previous; }

    Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight                 { focus-column-right; }
    Mod+WheelScrollLeft                  { focus-column-left; }

    Mod+Shift+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Shift+WheelScrollRight                 { move-column-right; }
    Mod+Shift+WheelScrollLeft                  { move-column-left; }

    Mod+1        { focus-workspace "terminal"; }
    Mod+2        { focus-workspace "browser"; }
    Mod+3        { focus-workspace "other"; }
    Mod+4        { focus-workspace "social"; }
    Mod+5        { focus-workspace 5; }
    Mod+6        { focus-workspace 6; }
    Mod+Shift+1  { move-column-to-workspace "terminal"; }
    Mod+Shift+2  { move-column-to-workspace "browser"; }
    Mod+Shift+3  { move-column-to-workspace "other"; }
    Mod+Shift+4  { move-column-to-workspace "social"; }
    Mod+Shift+5  { move-column-to-workspace 5; }
    Mod+Shift+6  { move-column-to-workspace 6; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }
    Mod+M       { maximize-window-to-edges; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { toggle-windowed-fullscreen; }
    Mod+C       { center-column; }

    Mod+P       { toggle-window-floating; }
    Mod+Shift+P { switch-focus-between-floating-and-tiling; }

    Mod+Minus       { set-column-width  "-1%"; }
    Mod+Equal       { set-column-width  "+1%"; }
    Mod+Shift+Minus { set-window-height "-1%"; }
    Mod+Shift+Equal { set-window-height "+1%"; }
}
